# Example only: run INSTALLER_WINDOWS.cmd (Windows) or python scripts/generate_config.py.
# Do not use placeholder values as production credentials.
GSI_TOKEN=
DASHBOARD_PIN=
# After changing: docker compose up -d --no-build --pull never --force-recreate --wait
# Or run APPLIQUER_REGLAGES_WINDOWS.cmd. A simple restart does not reload .env.
BOMB_TIMER_ENABLED=false
BOMB_DURATION_SECONDS=40
# 127.0.0.1 = local PC only; 0.0.0.0 = trusted LAN (configure the firewall).
BIND_HOST=127.0.0.1
PORT=8080
